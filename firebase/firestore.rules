rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function member(tavernId) {
      return signedIn() && exists(/databases/$(database)/documents/taverns/$(tavernId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
    }
    match /userStats/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /checkins/{checkInId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.status == 'VALIDATED');
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING_SYNC'
        && request.resource.data.xpEarned == 0;
      allow update, delete: if false;
    }
    match /taverns/{tavernId} {
      allow read: if member(tavernId);
      allow create: if signedIn();
      allow update: if member(tavernId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'emblem']);
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(tavernId);
        allow create: if owner(uid) && request.resource.data.userId == uid;
        allow update, delete: if owner(uid) && uid == request.auth.uid;
      }
      match /feed/{checkInId} {
        allow read: if member(tavernId);
        allow write: if false;
      }
      match /leaderboards/{period}/entries/{uid} {
        allow read: if member(tavernId);
        allow write: if false;
      }
    }
    match /invites/{code} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
