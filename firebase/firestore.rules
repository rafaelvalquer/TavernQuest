rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function member(tavernId) {
      return signedIn() && exists(/databases/$(database)/documents/taverns/$(tavernId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/taverns/$(tavernId)/members/$(request.auth.uid)).data.status == 'ACTIVE';
    }
    function tavernOwner(tavernId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/taverns/$(tavernId)).data.ownerId == request.auth.uid;
    }
    function validInvite(tavernId, code) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.tavernId == tavernId;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if false;
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);
      allow delete: if false;
    }
    match /userStats/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /checkins/{checkInId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING_SYNC'
        && request.resource.data.xpEarned == 0;
      allow update, delete: if false;
    }
    match /taverns/{tavernId} {
      allow read: if member(tavernId);
      allow create, update: if false;
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(tavernId);
        allow write: if false;
      }
      match /feed/{checkInId} {
        allow read: if member(tavernId);
        allow write: if false;
      }
      match /leaderboards/{period}/entries/{uid} {
        allow read: if member(tavernId);
        allow write: if false;
      }
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }
    match /missionLocks/{lockId} {
      allow read, write: if false;
    }
  }
}
